<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Configurations>Debug;Release</Configurations>
        <EnablePreviewFeatures>true</EnablePreviewFeatures>
        <GenerateRequiresPreviewFeaturesAttribute>False</GenerateRequiresPreviewFeaturesAttribute>
        <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
        <Version>1.0.61.0</Version>
        <LangVersion>latestmajor</LangVersion>
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DebugSymbols>False</DebugSymbols>
        <DebugType>None</DebugType>
        <DefineConstants />
    </PropertyGroup>

    <PropertyGroup Label="nuget">
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Authors>RapidStreamer</Authors>
        <Description>Redefining real time data streaming; effortless, blazingly fast and cloud-native for maximum impact</Description>
        <Copyright>Copyright ©2024 RapidStreamer Corporation</Copyright>
        <PackageProjectUrl>https://www.rapidstreamer.com</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/KAB-TEAM/RapidStreamer.Channels</RepositoryUrl>
        <PackageTags>Real-Time Data Streaming, Blazingly Fast, Cloud-Native, Data Streaming, Effortless Performance, High Impact, Real-Time Processing, Fast Data Pipelines, Cloud Solutions, Streaming Technology</PackageTags>
        <PackageIcon>RapidStreamer.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <AvoidCycleErrorOnSelfReference>true</AvoidCycleErrorOnSelfReference>
        <PackageId Condition="'$(Configuration)' == 'Debug' And '$(Platform)' != 'AnyCPU'">$(RootNameSpace).Debug.$(Platform)</PackageId>
        <PackageId Condition="'$(Configuration)' == 'Debug' And '$(Platform)' == 'AnyCPU'">$(RootNameSpace).Debug</PackageId>
        <PackageId Condition="'$(Configuration)' == 'Release' And '$(Platform)' != 'AnyCPU'">$(RootNameSpace).$(Platform)</PackageId>
        <PackageId Condition="'$(Configuration)' == 'Release' And '$(Platform)' == 'AnyCPU'">$(RootNameSpace)</PackageId>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="RapidStreamer.Debug.ARM64" Version="1.0.136" Condition="'$(Platform)' == 'ARM64'" />
        <PackageReference Include="RapidStreamer.Debug.x86" Version="1.0.136" Condition="'$(Platform)' == 'x86'" />
        <PackageReference Include="RapidStreamer.Debug.x64" Version="1.0.136" Condition="'$(Platform)' == 'x64'" />
        <PackageReference Include="RapidStreamer.Debug" Version="1.0.136" Condition="'$(Platform)' == 'AnyCPU'" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <PackageReference Include="RapidStreamer.ARM64" Version="1.0.136" Condition="'$(Platform)' == 'ARM64'" />
        <PackageReference Include="RapidStreamer.x86" Version="1.0.136" Condition="'$(Platform)' == 'x86'" />
        <PackageReference Include="RapidStreamer.x64" Version="1.0.136" Condition="'$(Platform)' == 'x64'" />
        <PackageReference Include="RapidStreamer" Version="1.0.136" Condition="'$(Platform)' == 'AnyCPU'" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\RapidStreamer.png" Pack="true" Link="RapidStreamer.png" PackagePath="" />
        <None Include="..\..\README.md" Pack="true" Link="README.md" PackagePath="" />
    </ItemGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.2" />
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.2" />
        <PackageReference Include="NodaTime" Version="3.2.1" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="TimeZonesChannelMetadata.cs">
            <DependentUpon>TimeZonesChannel.cs</DependentUpon>
        </Compile>
        <Compile Update="TimeZonesChannelFeederConfiguration.cs">
            <DependentUpon>TimeZonesChannelFeeder.cs</DependentUpon>
        </Compile>
        <Compile Update="TimeZonesChannelFeederMessage.cs">
            <DependentUpon>TimeZonesChannelFeeder.cs</DependentUpon>
        </Compile>
    </ItemGroup>

</Project>
