<Project Sdk="Microsoft.NET.Sdk">

    <!-- FFmpeg.AutoGen's generated bindings use unsafe pointer access to native FFmpeg structs. -->
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="$(ThunderPropagatorPackageId)"/>
        <PackageReference Include="Bogus"/>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="FFmpeg.AutoGen" />
        <PackageReference Include="SkiaSharp" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="VideoPlayerChannelFeederMessage.cs">
            <DependentUpon>VideoPlayerChannel.cs</DependentUpon>
        </Compile>
        <Compile Update="VideoPlayerChannelMetadata.cs">
            <DependentUpon>VideoPlayerChannel.cs</DependentUpon>
        </Compile>
        <Compile Update="VideoPlayerChannelConfiguration.cs">
            <DependentUpon>VideoPlayerChannel.cs</DependentUpon>
        </Compile>
    </ItemGroup>

</Project>
