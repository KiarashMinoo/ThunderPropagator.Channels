<Project Sdk="Microsoft.NET.Sdk">

    <!-- QuizChannel (and the public types alongside it this package consumes — QuizPhase,
         QuizScoreboardEntry, QuizProviderPublishRequest) derive from/reference a generic base in the
         referenced ThunderPropagator package that the analyzer treats as a preview API for a consumer
         outside its own declaring assembly, even though ThunderPropagator.Channels.Demo.Quiz itself
         compiles clean against it on every target framework this repo builds. Suppressed rather than
         opting in via EnablePreviewFeatures, since that would also mark this package's own public
         surface as requiring preview features for anyone consuming it in turn — not warranted here,
         and unrelated to CLAUDE.md's "preview language features only in test projects" (that's about
         C# language syntax, not this NuGet-package-level API-preview marker). -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);CA2252</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="$(ThunderPropagatorPackageId)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ThunderPropagator.Channels.Demo.Quiz\ThunderPropagator.Channels.Demo.Quiz.csproj"/>
    </ItemGroup>

</Project>
