<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <PackageReference Include="$(ThunderPropagatorPackageId)"/>
        <PackageReference Include="JetBrains.Annotations" />
    </ItemGroup>

    <ItemGroup>
        <!-- Issue #127: MapChatEndpoints exposes minimal-API routes (IEndpointRouteBuilder,
             TypedResults) alongside the existing WebSocket pipelines, so consuming hosts get both
             transports from one package. This project stays Sdk="Microsoft.NET.Sdk" rather than
             Sdk="Microsoft.NET.Sdk.Web" (it's a library, not a host); this FrameworkReference is the
             standard way for a class library to use ASP.NET Core types without becoming a web app
             itself. It also brings in Microsoft.Extensions.Identity.Core transitively, so the
             explicit PackageReference for it (used by IPasswordHasher<User>) was removed as
             redundant. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="ChatChannelFeederMessage.cs">
            <DependentUpon>ChatChannel.cs</DependentUpon>
        </Compile>
        <Compile Update="ChatChannelMetadata.cs">
            <DependentUpon>ChatChannel.cs</DependentUpon>
        </Compile>
        <Compile Update="ChatChannelConfiguration.cs">
            <DependentUpon>ChatChannel.cs</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Pipelines\Messages\"/>
    </ItemGroup>

</Project>
