<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <PropertyGroup>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <PropertyGroup Label="PackageId">
        <PackageId Condition="'$(Configuration)' == 'Debug' And '$(Platform)' != 'AnyCPU'">$(RootNameSpace).Debug.$(Platform)</PackageId>
        <PackageId Condition="'$(Configuration)' == 'Debug' And '$(Platform)' == 'AnyCPU'">$(RootNameSpace).Debug</PackageId>
        <PackageId Condition="'$(Configuration)' == 'Release' And '$(Platform)' != 'AnyCPU'">$(RootNameSpace).$(Platform)</PackageId>
        <PackageId Condition="'$(Configuration)' == 'Release' And '$(Platform)' == 'AnyCPU'">$(RootNameSpace)</PackageId>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="RapidStreamer.Debug.ARM64" Version="1.0.165" Condition="'$(Platform)' == 'ARM64'"/>
        <PackageReference Include="RapidStreamer.Debug.x86" Version="1.0.165" Condition="'$(Platform)' == 'x86'"/>
        <PackageReference Include="RapidStreamer.Debug.x64" Version="1.0.165" Condition="'$(Platform)' == 'x64'"/>
        <PackageReference Include="RapidStreamer.Debug" Version="1.0.165" Condition="'$(Platform)' == 'AnyCPU'" />
        <PackageReference Include="RapidStreamer.BuildingBlocks.Modules.Debug.ARM64" Version="1.0.128" Condition="'$(Platform)' == 'ARM64'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Modules.Debug.x86" Version="1.0.128" Condition="'$(Platform)' == 'x86'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Modules.Debug.x64" Version="1.0.128" Condition="'$(Platform)' == 'x64'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Modules.Debug" Version="1.0.128" Condition="'$(Platform)' == 'AnyCPU'" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <PackageReference Include="RapidStreamer.ARM64" Version="1.0.165" Condition="'$(Platform)' == 'ARM64'"/>
        <PackageReference Include="RapidStreamer.x86" Version="1.0.165" Condition="'$(Platform)' == 'x86'"/>
        <PackageReference Include="RapidStreamer.x64" Version="1.0.165" Condition="'$(Platform)' == 'x64'"/>
        <PackageReference Include="RapidStreamer" Version="1.0.165" Condition="'$(Platform)' == 'AnyCPU'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Modules.ARM64" Version="1.0.128" Condition="'$(Platform)' == 'ARM64'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Modules.x86" Version="1.0.128" Condition="'$(Platform)' == 'x86'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Modules.x64" Version="1.0.128" Condition="'$(Platform)' == 'x64'"/>
        <PackageReference Include="RapidStreamer.BuildingBlocks.Modules" Version="1.0.128" Condition="'$(Platform)' == 'AnyCPU'"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="ResourceMonitoringChannelMetadata.cs">
            <DependentUpon>ResourceMonitoringChannel.cs</DependentUpon>
        </Compile>
        <Compile Update="ResourceMonitoringChannelFeederMessage.cs">
            <DependentUpon>ResourceMonitoringChannelFeeder.cs</DependentUpon>
        </Compile>
        <Compile Update="ResourceMonitoringChannelFeederConfiguration.cs">
            <DependentUpon>ResourceMonitoringChannelFeeder.cs</DependentUpon>
        </Compile>
        <Compile Update="ResourceMonitoringChannelConfiguration.cs">
            <DependentUpon>ResourceMonitoringChannel.cs</DependentUpon>
        </Compile>
    </ItemGroup>

</Project>
