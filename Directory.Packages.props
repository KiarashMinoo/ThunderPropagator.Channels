<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="$(ThunderPropagatorPackageId)" Version="1.0.1-beta.216" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="8.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="9.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'" Label="Microsoft.EntityFrameworkCore">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'" Label="Microsoft.EntityFrameworkCore">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'" Label="Microsoft.EntityFrameworkCore">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="MongoDB.Driver" Version="3.*" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageVersion Include="SkiaSharp" Version="4.151.2" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="NodaTime" Version="3.3.3" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
