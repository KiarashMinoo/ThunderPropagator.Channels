<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <PropertyGroup Label="ThunderPropagatorPackages">
    <ThunderPropagatorVersion>1.0.1-beta.17</ThunderPropagatorVersion>
    <ThunderPropagatorPackageId>ThunderPropagator$(PackageIdConfigurationSuffix)$(PackageIdPlatformSuffix)</ThunderPropagatorPackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="$(ThunderPropagatorPackageId)" Version="$(ThunderPropagatorVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="8.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="9.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="NodaTime" Version="3.3.2" />
    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="coverlet.collector" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>